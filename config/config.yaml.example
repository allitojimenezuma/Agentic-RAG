# Agentic RAG configuration example
# Copy to config/config.yaml and edit as needed

openai_api_key: sk-...
openai_base_url: https://api.openai.com/v1
openai_model: gpt-4.1-mini
wiki_path: ./wiki
raw_sources_path: ./raw
agents_md_path: ./AGENTS.md
recursion_limit: 12
hitl_enabled: true
retrieval_mode: index
markitdown_llm_describe_images: false
